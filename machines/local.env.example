# podmanager: per-host values for machine profiles.
#
# Copy to machines/local.env (gitignored) on each host and fill in real paths.
# Host paths contain the username, so they never get committed. Same format
# as .env.local: every line is `export KEY="value"`.

# Fixed shared volume, mounted writable at /shared in machines whose profile
# sets SHARED=true. Lives outside the repo so staged material can't be
# committed by accident. Created by machine-switch.sh if missing.
export PODMANAGER_SHARED="/path/to/podmanager-shared"

# --- Per-project workspaces ------------------------------------------------
# opencode: host folder shared as /workspace.
export OPENCODE_WORKSPACE="/path/to/opencode-ws"
