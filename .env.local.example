# podmanager: run-time secrets template.
#
# Copy to .env.local (gitignored), fill in real values, then load it into the
# shell before running scripts or Claude Code:
#   source .env.local && claude
# Target state (T-OPENCODE-06): keep it encrypted with ansible-vault and load
# it without leaving a plaintext copy on disk:
#   ansible-vault encrypt .env.local
#   source <(ansible-vault view .env.local) && claude
#
# Format: every line is `export KEY="value"`. One format everywhere, so `source`
# works and a loader can still read it as KEY=value after dropping `export`.
# - No YAML (`key: value`) and no bare values: `source` tries to run them as a
#   command, and the shell echoes the secret into the terminal and transcript.
# - Not a `podman --env-file`: podman keeps the quotes as part of the value.
#   Pass secrets into containers by name instead. `podman run -e OMLX_API_KEY`
#   takes the value from the shell, so it never appears on the command line.

# --- Host model server (oMLX) ----------------------------------------------
# API key for oMLX on the host: admin dashboard and /v1 API calls. The OpenCode
# image and its smoke test use it.
export OMLX_API_KEY="REPLACE-ME"

# --- GHCR (T-OPENCODE-07) --------------------------------------------------
# GitHub username, not the email address (registries reject an email login).
export GHCR_USER="REPLACE-ME"
# Classic PAT, scope write:packages. Push side: only where images get published.
export GHCR_WRITE_TOKEN="REPLACE-ME"
# Classic PAT, scope read:packages. Pull side: every consuming cluster.
export GHCR_READ_TOKEN="REPLACE-ME"

# --- Optional --------------------------------------------------------------
# Slack bot token for the Slack MCP server (korotovsky/slack-mcp-server).
export SLACK_MCP_XOXB_TOKEN="xoxb-REPLACE-ME"
